# ═══════════════════════════════════════════════════════════════
# MTGroup VPN Ultimate — Environment Configuration
# Copy this file to .env and customize for your deployment
# ═══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
APP_NAME=MTGroup VPN Ultimate
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8443
BASE_URL=https://panel.example.com
WORKERS=4

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./mtgroup.db

# ── JWT / Auth ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Default Admin ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ── TLS ───────────────────────────────────────────────────────
# TLS_CERT_PATH=/etc/ssl/certs/panel.crt
# TLS_KEY_PATH=/etc/ssl/private/panel.key
CORS_ORIGINS=*

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FAILED_LOGINS=5
MAX_ANOMALOUS_HANDSHAKES=3
BAN_DURATION_HOURS=24

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=0
TELEGRAM_ENABLED=false

# ── Cloud Providers ───────────────────────────────────────────
HETZNER_API_TOKEN=
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=

# ── CDN ───────────────────────────────────────────────────────
CDN_WORKER_URL=
CDN_ENABLED=false

# ── Subscription Defaults ────────────────────────────────────
DEFAULT_PROTOCOLS=vless_reality,hysteria2
DEFAULT_SNI=www.google.com
DEFAULT_FINGERPRINT=chrome
SUBSCRIPTION_PATH_PREFIX=/sub

# ── Port Hopping ──────────────────────────────────────────────
PORT_POOL_LOW=80,443,8080,8888
PORT_POOL_HIGH_START=50000
PORT_POOL_HIGH_END=65000
PORT_HOP_INTERVAL_SEC=1

# ── Traffic Shaping ───────────────────────────────────────────
TRAFFIC_SHAPE_MODE=video_stream
JITTER_MIN_MS=5
JITTER_MAX_MS=50
CHAFF_INTERVAL_SEC=0.5

# ── TLS Fragmentation ────────────────────────────────────────
TLS_FRAGMENT_ENABLED=true
TLS_FRAGMENT_SIZE_MIN=50
TLS_FRAGMENT_SIZE_MAX=200
TLS_FRAGMENT_INTERVAL_MIN_MS=10
TLS_FRAGMENT_INTERVAL_MAX_MS=50
TLS_PADDING_MIN=64
TLS_PADDING_MAX=512

# ── Zero-Knowledge Database Encryption ────────────────────────
# 64-char hex string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DB_ENCRYPTION_KEY=

# ── Active Probe Deflection ──────────────────────────────────
DECOY_REVERSE_PROXY_TARGET=https://www.microsoft.com

# ── Post-Quantum Shield ──────────────────────────────────────
QUANTUM_SHIELD_ENABLED=false

# ── eBPF / Kernel ─────────────────────────────────────────────
EBPF_ENABLED=false
EBPF_INTERFACE=eth0
NFTABLES_ENABLED=false

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=mtgroup.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Xray REALITY ──────────────────────────────────────────────
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
